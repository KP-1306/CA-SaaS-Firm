# =============================================================================
# CA Firm Operations SaaS — environment variable NAMES ONLY
# =============================================================================
# Copy to `.env` and supply real values locally. `.env` is git-ignored.
# NEVER commit real secrets. Production secrets are retrieved from AWS Secrets
# Manager (EIB §4.13) — this file documents the variable contract only.
# =============================================================================

# ---- Django core ----
# Which settings module to load: config.settings.development | .test | .production
DJANGO_SETTINGS_MODULE=config.settings.development

# Cryptographic signing key. Production MUST supply this; startup fails without it.
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-locally-generated-development-value

# Comma-separated hostnames. Production MUST supply this; startup fails without it.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database (PostgreSQL 16 — TAD §5) ----
# No database connection is opened by EWP-000.1A. Provisioning is a later EWP.
POSTGRES_DB=cafirm_dev
POSTGRES_USER=cafirm_app
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Frontend ----
# Base URL the SPA calls. No trailing slash.
VITE_API_BASE_URL=http://localhost:8000

# =============================================================================
# Deliberately ABSENT until the owning work package adds them:
#   Redis / Celery .................... EWP owning background processing
#   AWS S3 / object storage ........... EWP owning document storage
#   Amazon SES / email ................ EWP owning notifications
#   ClamAV ............................ EWP owning document scanning
#   Sentry / OpenTelemetry ............ EWP owning observability
#   AWS Secrets Manager ............... EWP owning secrets integration
# Adding them now would exceed EWP-000.1A scope (EWP-000.1A §5).
# =============================================================================

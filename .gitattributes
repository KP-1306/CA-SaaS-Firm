# Normalise line endings: LF in the repository, native in the working tree.
# Required because the team develops on Windows and deploys to Linux (EIB §10).
* text=auto eol=lf

*.py    text eol=lf diff=python
*.pyi   text eol=lf diff=python
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.sh    text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf

# Windows-only scripts keep CRLF
*.bat   text eol=crlf
*.ps1   text eol=crlf

# Binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary

# Lock files: single-line diffs are unhelpful; mark as generated
package-lock.json  linguist-generated=true -diff
